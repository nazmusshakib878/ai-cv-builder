# =========================================================
# Resumate AI — Production Environment Variables Reference
# =========================================================

# 1. Base Application URL
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# 2. AI Engine Configuration (Google Gemini Free Tier as Primary)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-developer-api-key-here

# Optional Secondary Provider:
OPENAI_API_KEY=sk-your-openai-api-key-here

# 3. Cryptographic JWT Secret for User & Guest Sessions (Min 64 characters recommended)
JWT_SECRET=your-cryptographically-secure-random-jwt-secret-min-64-chars

# 4. Supabase Database & Auth (PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 5. bKash Merchant Payment Gateway (Optional for now)
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-merchant-username
BKASH_PASSWORD=your-bkash-merchant-password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh

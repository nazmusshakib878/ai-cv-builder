# =========================================================
# Resumate AI — Production Environment Variables Reference
# =========================================================

# 1. Base Application URL
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# 2. OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# 3. Cryptographic JWT Secret for User & Guest Sessions
JWT_SECRET=your-cryptographically-secure-random-jwt-secret-min-32-chars

# 4. Supabase Database & Auth (PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 5. bKash Merchant Payment Gateway
# In Production: https://tokenized.pay.bka.sh
# In Sandbox/Testing: https://tokenized.sandbox.bka.sh
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-merchant-username
BKASH_PASSWORD=your-bkash-merchant-password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh
